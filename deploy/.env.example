# Server-side config for https://airbnb.kaitr.dev  ->  copy to ~/apps/airbnb/.env and `chmod 600` it.
# The Deploy workflow copies it next to docker-compose.prod.yml. After editing, re-run Deploy.
# Generate secrets with:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-40

# --- Database / queue (internal network only) ---
POSTGRES_USER=airbnb
POSTGRES_PASSWORD=            # required
POSTGRES_DB=ecommerce_db
RABBITMQ_USER=airbnb
RABBITMQ_PASSWORD=            # required

# --- Demo login (one-click guest/host accounts) ---
DEMO_JWT_SECRET=              # required, >= 32 chars
DEMO_USER_IDS=500001,2884     # demo guest, demo host

# --- Auth0 (optional; leave all empty to offer demo accounts only) ---
# Backend verifies tokens with these:
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://airbnb.kaitr.dev/api
# Frontend build args (public values, end up in the JS bundle):
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=https://airbnb.kaitr.dev/api

# --- Admin endpoints (user list, disable account). Empty = nobody. ---
ADMIN_USER_IDS=

# --- Optional integrations (features hide/disable themselves when empty) ---
NEXT_PUBLIC_LOCATIONIQ_API_KEY=   # restrict the key to airbnb.kaitr.dev in the LocationIQ dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
