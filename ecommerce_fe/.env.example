# Frontend build-time config. NEXT_PUBLIC_* values are embedded in the JS bundle: never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Auth0 (optional). Leave empty to offer demo accounts only.
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=https://airbnb.kaitr.dev/api

# Payments: true = simulated (no ZaloPay)
NEXT_PUBLIC_PAYMENT_MOCK=true

# Optional integrations; features hide themselves when empty
NEXT_PUBLIC_LOCATIONIQ_API_KEY=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
